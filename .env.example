# Required
# Use a long random secret in production.
JWT_SECRET=replace-with-a-long-random-secret

# Runtime settings
# Default single-node layout keeps both DB and storage under ./data
PEANUT_HOST_PORT=3492
DATABASE_URL=sqlite://data/peanut.db
STORAGE_DIR=data/storage

# Auth settings
# Peanut now provides external-app auth flows (login, refresh, logout, password reset).
# PASSWORD_RESET_DELIVERY controls how reset tokens are delivered.
# - inline: include reset_token in the forgot-password JSON response
# - log: hide the token from the API response and write it to the server log instead
PASSWORD_RESET_DELIVERY=log
# Production note: inline reset delivery exposes reset tokens in API responses.
# Prefer PASSWORD_RESET_DELIVERY=log for operator-managed production installs.

# Functions run trusted admin-managed JS/TS code through a local Node subprocess.
# Set FUNCTIONS_ENABLED=false if this install does not need runtime extensions.
FUNCTIONS_ENABLED=true
FUNCTIONS_ALLOW_NETWORK=false
# Maximum simultaneous Function invocations in this Peanut process.
FUNCTIONS_MAX_CONCURRENT=4
# Per-invocation Node heap cap and payload/log guardrails.
FUNCTIONS_MEMORY_MB=128
FUNCTIONS_MAX_SOURCE_BYTES=262144
FUNCTIONS_MAX_OUTPUT_BYTES=65536
# Optional dedicated encryption key for stored Function secrets.
# Defaults to JWT_SECRET when unset; use a separate long secret for production installs.
FUNCTIONS_SECRETS_MASTER_KEY=
# Defaults to the OS temp directory joined with peanut-functions when unset.
# FUNCTIONS_WORK_DIR=/tmp/peanut-functions

# Run one SQLite backup during startup before Peanut accepts requests.
BACKUP_ON_STARTUP=false

# Only trust x-forwarded-for when Peanut is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Multipart staging cleanup.
MULTIPART_STALE_HOURS=24
MULTIPART_CLEANUP_INTERVAL_SECONDS=3600

# Optional auth client/origin policy for app-facing auth routes.
# When AUTH_ALLOWED_ORIGINS is set, matching Origin header is required on auth routes.
# When AUTH_ALLOWED_CLIENT_IDS is set, matching x-peanut-client-id header is required.
# AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AUTH_ALLOWED_CLIENT_IDS=peanut-web-dev

# Bind address
# Use 0.0.0.0:3000 in containers / reverse-proxy setups.
# PEANUT_HOST_PORT controls the host port published by Docker Compose.
# Use 127.0.0.1:3000 only for direct local host runs outside Docker.
BIND_ADDR=0.0.0.0:3000

# Upload / logging
MAX_UPLOAD_BYTES=5242880
RUST_LOG=info

# Optional ntfy settings for topic delivery.
# Uncomment to use the public ntfy service, or point this at your self-hosted ntfy server.
# NTFY_BASE_URL=https://ntfy.sh
# Optional bearer token for authenticated ntfy servers
# NTFY_AUTH_TOKEN=

# Optional Web Push delivery settings
# Required only if you want worker delivery to browser Web Push subscriptions.
# SUBJECT must start with mailto: or https://
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
